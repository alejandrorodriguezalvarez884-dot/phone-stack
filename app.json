{
  "expo": {
    "name": "Phone Stack",
    "slug": "phone-stack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F060A",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alejandrorodriguez.phonestack",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.alejandrorodriguez.phonestack",
      "adaptiveIcon": {
        "backgroundColor": "#2A0E18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Phone Stack uses the motion sensors to notice when you pick your phone up from the table."
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F060A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "./plugins/withSceneLifecycle"
    ]
  }
}
